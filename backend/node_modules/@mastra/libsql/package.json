{
  "name": "@mastra/libsql",
  "version": "1.21.1",
  "description": "Libsql provider for Mastra - includes both vector and db storage capabilities",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@libsql/client": "^0.17.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "eslint": "^10.7.0",
    "tsdown": "0.22.9",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "4.1.10",
    "@internal/lint": "0.0.125",
    "@internal/storage-test-utils": "0.0.121",
    "@internal/types-builder": "0.0.100",
    "@mastra/core": "1.61.0"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.51.0-0 <2.0.0-0"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "stores/libsql"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:lib": "tsdown --silent --config tsdown.config.ts",
    "build:watch": "tsdown --watch --silent --config tsdown.config.ts",
    "test": "vitest run",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint --fix . && eslint --fix ."
  }
}